script-source,97,node:readline/promises,'use strict';\n\nconst {\n  Promise\x2C\n  SymbolDispose\x2C\n} = primordials;\n\nconst {\n  Readline\x2C\n} = require('internal/readline/promises');\n\nconst {\n  Interface: _Interface\x2C\n  kQuestion\x2C\n  kQuestionCancel\x2C\n  kQuestionReject\x2C\n} = require('internal/readline/interface');\n\nconst {\n  AbortError\x2C\n} = require('internal/errors');\nconst { validateAbortSignal } = require('internal/validators');\n\nconst {\n  kEmptyObject\x2C\n} = require('internal/util');\nlet addAbortListener;\n\nclass Interface extends _Interface {\n  question(query\x2C options = kEmptyObject) {\n    return new Promise((resolve\x2C reject) => {\n      let cb = resolve;\n\n      if (options?.signal) {\n        validateAbortSignal(options.signal\x2C 'options.signal');\n        if (options.signal.aborted) {\n          return reject(\n            new AbortError(undefined\x2C { cause: options.signal.reason }));\n        }\n\n        const onAbort = () => {\n          this[kQuestionCancel]();\n          reject(new AbortError(undefined\x2C { cause: options.signal.reason }));\n        };\n        addAbortListener ??= require('internal/events/abort_listener').addAbortListener;\n        const disposable = addAbortListener(options.signal\x2C onAbort);\n\n        cb = (answer) => {\n          disposable[SymbolDispose]();\n          resolve(answer);\n        };\n      }\n\n      this[kQuestionReject] = reject;\n\n      this[kQuestion](query\x2C cb);\n    });\n  }\n}\n\nfunction createInterface(input\x2C output\x2C completer\x2C terminal) {\n  return new Interface(input\x2C output\x2C completer\x2C terminal);\n}\n\nmodule.exports = {\n  Interface\x2C\n  Readline\x2C\n  createInterface\x2C\n};\n
